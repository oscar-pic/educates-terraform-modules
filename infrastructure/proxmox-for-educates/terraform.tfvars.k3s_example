deployment_flavor = "single-node-k3s"

# Connection & Auth
proxmox_nodes          = ["pve01", "pve02", "pve03"] # Array begins in position 0
# Leave next one empty for single-node-k3s; 
proxmox_nodes_ceph_IPs = []
proxmox_endpoint       = "https://192.168.80.200:8006/"
proxmox_api_token      = "terraform-user@pve!TF-Token=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Leave all ceph block variables empty for single-node-k3s
proxmox_ceph_clusterID = ""
proxmox_ceph_k8s_key   = ""

k8s_cert_strategy                      = "self-signed"          # Options: 'provided', 'self-signed', 'letsencrypt'. Let's Encrypt not tested yet
k8s_apps_cert_domains                  = ["*.app.domain.net"]   # Must be a public domain for use with Let's Encrypt option
k8s_letsencrypt_email                  = "admin@app.domain.net" # Only used with Let's Encrypt option
k8s_letsencrypt_dns_provider_api_token = ""                     # Cloudflare, route53, google... Only used with Let's Encrypt option
# Leave Gateway API specific variable empty for single-node-k3s
k8s_gateway_api_lb_ip_range            = ""

# Storage & Images
proxmox_images_snippets_datastore = {
  # The datasotre has to permit both ISO and snippets content types, since we use it for both OS image and cloud-init snippets.
  name   = "nfs-shared"
  shared = true
}
proxmox_vms_datastore    = {
  name   = "ceph-shared"
  shared = true
}

# Leave the next two variables empty for Talos, as it will fetch the ISO from the Talos Factory data source.
cloud_image_url        = "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
proxmox_image_filename = "ubuntu-24.04-cloud.img"

# SSH Path to connect to Proxmox nodes and to inject into the VMs.
ssh_private_key_path = "~/.ssh/id_ed25519"

# Leave those five empty for single-node-k3s
# Fill it only when you move to a multi-node cluster with a VIP, and an interface to configure this VIP.
k8s_api_endpoint_vip    = ""
k8s_api_cp_interface    = ""
k8s_cluster_token       = ""
k8s_ceph_node_interface = ""
k8s_ceph_network_cidr   = ""

system_timezone = "Europe/Madrid"

# Your Node Definition
kube_nodes = {
  "single-node-k3s-01" = {
    type                = "single-node-k3s" # Options: k3s --> single-node-k3s, rke2 --> rke2-server-bootstrap, rke2-server, rke2-agent
    proxmox_host        = 0
    #mac_address         = "BC:24:11:AA:BB:CC"
    ip_address          = "192.168.80.201/24"
    gateway             = "192.168.80.1"
    dns_servers         = ["8.8.8.8", "1.1.1.1"]
    network_bridge      = "vmbr0"
    # Leave Ceph variables empty for single-node-k3s
    ceph_ip_address     = ""
    ceph_network_bridge = ""
    vm_user             = "ubuntu"
    vm_password         = "Ubuntu1!"
    ssh_key_path        = "~/.ssh/id_ed25519.pub"
    vm_cores            = 4
    vm_memory           = 12288
    vm_disk_size      = 60
    node_labels         = ["flavor=single-node-k3s", "role=all", "os=k3s"]
  }
}