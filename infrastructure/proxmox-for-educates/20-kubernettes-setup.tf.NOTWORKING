resource "null_resource" "verify_node_online" {
  for_each   = var.kube_nodes
  depends_on = [time_sleep.wait_for_needed_reboot_cycle]

  provisioner "remote-exec" {
    connection {
      type        = "ssh"
      user        = each.value.vm_user
      host        = split("/", each.value.ip_address)[0]
      private_key = file(var.ssh_private_key_path)
      timeout     = "12m"
    }

    inline = [
      "set -e",
      "echo '------------------------------------------------------------'",
      "echo '🖥️  SSH connection established with ${split("/", each.value.ip_address)[0]}'",
      "echo '⏳ Waiting for Kubernetes service to be fully active...'",
      "echo '------------------------------------------------------------'",

      # Evaluate systemd service and node type flags
      "SERVICE_NAME='${local.is_k3s ? "k3s" : (each.value.type == "rke2-agent" ? "rke2-agent" : "rke2-server")}'",
      "IS_SERVER='${local.is_k3s || each.value.type == "rke2-server" || each.value.type == "rke2-server-bootstrap" ? "true" : "false"}'",

      # Wait for local systemd service initialization
      "TIMEOUT=300",
      "ELAPSED=0",
      "until sudo systemctl is-active --quiet \"$SERVICE_NAME\"; do",
      "  if [ \"$ELAPSED\" -ge \"$TIMEOUT\" ]; then",
      "    echo \"❌ ERROR: Kubernetes service ($SERVICE_NAME) failed to start within $TIMEOUT seconds.\"",
      "    exit 1",
      "  fi",
      "  echo \"🔄 Service '$SERVICE_NAME' is still initializing... ($ELAPSED/$TIMEOUT s)\"",
      "  sleep 10",
      "  ELAPSED=$((ELAPSED + 10))",
      "done",
      "echo \"✅ Systemd service ($SERVICE_NAME) is ACTIVE!\"",

      # Extended validation loop for Control Plane nodes
      "if [ \"$IS_SERVER\" = \"true\" ]; then",
      "  echo '------------------------------------------------------------'",
      "  echo '🛡️  Control Plane node detected. Initiating internal cluster sanity checks...'",
      
      # Establish clean absolute path reference
      "  if ${local.is_k3s}; then KCONF=/etc/rancher/k3s/k3s.yaml; else KCONF=/etc/rancher/rke2/rke2.yaml; fi",
      
      # Monitor local API server availability using explicit path parameter flags
      "  echo '⏳ Waiting for local API Server to respond...'",
      "  until sudo kubectl --kubeconfig $KCONF get nodes >/dev/null 2>&1; do",
      "    sleep 5",
      "  done",
      "  echo '✅ API Server is responding!'",

      # Monitor specific Node object initialization
      "  echo '⏳ Waiting for this node to report Status=Ready in Kubernetes...'",
      "  until [ \"$(sudo kubectl --kubeconfig $KCONF get node $(hostname) -o jsonpath='{.status.conditions[?(@.type==\"Ready\")].status}')\" = \"True\" ]; do",
      "    sleep 5",
      "  done",
      "  echo '✅ Node $(hostname) reports status READY!'",

      # Monitor core system infrastructure daemonsets stabilization
      "  echo '⏳ Waiting for Core Infrastructure Pods (Cilium / Kube-VIP) to stabilize...'",
      "  echo '   (All core pods in kube-system must pass readiness probes)'",
      "  CORE_TIMEOUT=300",
      "  CORE_ELAPSED=0",
      "  until ! sudo kubectl --kubeconfig $KCONF get pods -n kube-system -o jsonpath='{.items[*].status.containerStatuses[*].ready}' | grep -q 'false'; do",
      "    if [ \"$CORE_ELAPSED\" -ge \"$CORE_TIMEOUT\" ]; then",
      "      echo '⚠️  WARNING: Core pods are taking longer than expected to report Ready.'",
      "      echo '   Terraform will proceed, but some daemonsets are still reconciling.'",
      "      break",
      "    fi",
      "    echo \"🔄 Waiting for kube-system pods to settle... ($CORE_ELAPSED/$CORE_TIMEOUT s)\"",
      "    sleep 15",
      "    CORE_ELAPSED=$((CORE_ELAPSED + 15))",
      "  done",
      "  echo '✅ Kube-system core components have stabilized!'",
      "fi",

      "echo '------------------------------------------------------------'",
      "echo '🚀 Node ${split("/", each.value.ip_address)[0]} verification workflow completed successfully!'",
      "echo '------------------------------------------------------------'",
      "sleep 5"
    ]
  }
}