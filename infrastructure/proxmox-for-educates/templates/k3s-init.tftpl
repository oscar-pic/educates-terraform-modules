#cloud-config
hostname: ${hostname}
write_files:
  - path: /etc/rancher/k3s/config.yaml.d/node-custom.yaml
    content: |
      ${extra_configs}
ntp:
  enabled: true
  servers:
    - 0.es.pool.ntp.org
    - 1.es.pool.ntp.org
    - time.google.com
runcmd:
  - curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="server --write-kubeconfig-mode 644" sh -
