apiVersion: "k8s.cni.cncf.io/v1"
kind: NetworkAttachmentDefinition
metadata:
  name: ceph-storage-net
  namespace: kube-system
spec:
  config: '{
    "cniVersion": "0.3.1",
    "type": "macvlan",
    "master": "${interface_name}",
    "mode": "bridge",
    "mtu": "${mtu}",
    "ipam": {
      "type": "host-local",
      "subnet": "${subnet}",
      "rangeStart": "${rangeStart}",
      "rangeEnd": "${rangeEnd}"
    }
  }'