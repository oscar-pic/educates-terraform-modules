# Settings for scripts/jump-host.sh. Copy to jump-host.env (git-ignored) and edit.
# Nothing here is secret: the Proxmox tokens live in proxmox.env on the jump host.

# SSH destination: host, user@host, or an alias from ~/.ssh/config.
JUMP_HOST=bastion.example.com

# Working directory on the jump host. Quote it, so ~ is the jump host's home.
JUMP_DIR='~/educates'

# Repository and ref to deploy. Defaults: this clone's 'origin' URL and its HEAD commit (it must be pushed).
# REPO_URL=https://github.com/educates/educates-terraform-modules.git
# REPO_REF=main
