deployment_flavor = "talos"

# Connection & Auth
proxmox_nodes          = ["pve01", "pve02", "pve03"] # Array begins in position 0 
# Leave next one empty for k3s; 
proxmox_nodes_ceph_IPs = ["10.10.80.20", "10.10.80.21", "10.10.80.22"]
proxmox_endpoint       = "https://192.168.80.200:8006/"
proxmox_api_token      = "terraform-user@pve!TF-Token=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Leave all ceph block variables empty for k3s
proxmox_ceph_clusterID = "xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxx"
proxmox_ceph_k8s_key   = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# CSI storage backend(s) for the K8s PVCs: 'ceph' (RBD+CephFS), 'nfs', or 'both'. Not used by k3s.
k8s_storage_backend = "ceph"

# Only needed when k8s_storage_backend is 'nfs' or 'both':
#nfs_csi_version        = "4.13.4"
#nfs_csi_server_address = "10.10.80.10"
#nfs_csi_share_path     = "/volume1/k8s"
#nfs_csi_mount_options  = ["nfsvers=4.1"]

k8s_cert_strategy                      = "self-signed"               # Options: 'provided', 'self-signed', 'letsencrypt'. Let's Encrypt not tested yet
k8s_certs_path                         = "certs"                     # It's only neccesary if k8s_cert_stragegy is "provided"
k8s_apps_cert_domains                  = ["*.talos-apps.lab.inet"]   # Must be a public domain for use with Let's Encrypt option
k8s_letsencrypt_email                  = "admin@talos-apps.lab.inet" # Only used with Let's Encrypt option
k8s_letsencrypt_dns_provider_api_token = ""                          # Cloudflare, route53, google... Only used with Let's Encrypt option
# Leave Gateway API specific variable empty for k3s
k8s_gateway_api_lb_ip_range            = "192.168.80.50/26"

# Storage & Images
proxmox_images_snippets_datastore = {
  # The datasotre has to permit both ISO and snippets content types, since we use it for both OS image and cloud-init snippets.
  name   = "nfs-shared"
  shared = true
}
proxmox_vms_datastore    = {
  name   = "ceph-shared"
  shared = true
}

# Leave the next two variables empty for Talos, as it will fetch the ISO from the Talos Factory data source.
cloud_image_url        = "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
proxmox_image_filename = "ubuntu-24-cloud.img"

# --- Variables for Talos Flavor. Leave empty for k3s or rke2 ---
talos_cluster_name     = "talos-proxmox-cluster"
talos_compiled_version = "v1.13.4"
talos_compiled_extensions = [
  "siderolabs/qemu-guest-agent",
  "siderolabs/util-linux-tools",
  "siderolabs/intel-ucode"
]

# SSH Path to connect to Proxmox nodes and to inject into the VMs.
ssh_private_key_path = "~/.ssh/id_ed25519"

# Leave those five empty for k3s 
# Fill it only when you move to a multi-node cluster with a VIP, and an interface to configure this VIP.
k8s_api_endpoint_vip    = "192.168.80.200"
k8s_api_cp_interface    = "eth0"
k8s_cluster_token       = "secret-xxxxxx-xxxx-xxxxxx"
k8s_ceph_node_interface = "eth1"
k8s_ceph_network_cidr   = "10.10.80.0/24"

system_timezone = "Europe/Madrid"

