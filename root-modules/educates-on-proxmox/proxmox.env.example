# Secrets for OpenTofu/Terraform, as environment variables. Never commit the real file.
#
# Copy it OUTSIDE the repository clone (for example <work dir>/proxmox.env), make it
# readable only by you (chmod 600), and load it only into the shell that runs OpenTofu:
#
#   set -a; . <work dir>/proxmox.env; set +a
#
# scripts/jump-host.sh loads <JUMP_DIR>/proxmox.env on the jump host by itself.
# How to create the tokens: infrastructure/proxmox-for-educates/docs/requirements.md#credentials

# Token for OpenTofu/Terraform: '<user>@<realm>!<token name>=<secret>'.
TF_VAR_proxmox_api_token='terraform@pve!educates=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'

# Secret of the Proxmox CSI token (its ID goes in storage.proxmox_csi.token_id). Only with Proxmox CSI.
TF_VAR_proxmox_csi_token_secret='xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'

# Ceph CSI keys ('ceph auth get-key client.<name>'). Only with Ceph CSI:
# one client for both drivers...
# TF_VAR_ceph_csi_user_key='AQ...=='
# ...or one per driver (ceph_csi.rbd.user_id, ceph_csi.cephfs.user_id).
# TF_VAR_ceph_csi_rbd_user_key='AQ...=='
# TF_VAR_ceph_csi_cephfs_user_key='AQ...=='
